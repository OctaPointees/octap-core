# Reserved configuration; integrations are not connected by this scaffold.
API_HOST=127.0.0.1
API_PORT=3000
GRPC_HOST=127.0.0.1
GRPC_PORT=50051
# Supabase PostgreSQL Connection String
# Pooler (Supavisor / port 6543, recommended for multi-worker scaling):
# DATABASE_URL=postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# Direct connection (port 5432):
# DATABASE_URL=postgresql://postgres:[db-password]@db.[project-ref].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=
DB_MAX_CONNECTIONS=10
REDIS_URL=
SUI_NETWORK=testnet
SUI_GRPC_URL=
SUI_PACKAGE_ID=
ENOKI_PRIVATE_API_KEY=
GOOGLE_CLIENT_ID=
OIDC_ISSUER=
OIDC_AUDIENCE=
CLICKHOUSE_URL=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
WALRUS_PUBLISHER_URL=
WALRUS_AGGREGATOR_URL=
SEAL_KEY_SERVER_URLS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
WEBHOOK_SIGNING_SECRET=
