API_HOST=127.0.0.1
API_PORT=3000
# Supabase PostgreSQL Connection String
# Pooler (Supavisor / port 6543, recommended for multi-worker scaling):
# DATABASE_URL=postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# Direct connection (port 5432):
# DATABASE_URL=postgresql://postgres:[db-password]@db.[project-ref].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=
DB_MAX_CONNECTIONS=10
# `docker-compose up -d` (see docker-compose.yml) gives you a local Postgres on 5433
# (not 5432, to avoid clashing with one already running on the host) and Redis on 6379:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/octap_dev
REDIS_URL=redis://127.0.0.1:6379
# Requests allowed per API credential per 60s window (api/src/infra/auth/rate-limit.util.ts).
RATE_LIMIT_MAX_REQUESTS=120
# Requests allowed per client IP per 60s window on public customer routes
# (api/src/infra/auth/public-rate-limit.guard.ts). A merchant server that proxies these routes
# counts as one IP, so raise this if a store's customers share a limit through its backend.
PUBLIC_RATE_LIMIT_MAX_REQUESTS=60
# Reverse proxies in front of the API whose X-Forwarded-For can be trusted. 0 (direct) ignores the
# header, because a client could otherwise forge a new IP on every request.
TRUSTED_PROXY_HOPS=0
# Serve Swagger UI at /docs and the OpenAPI spec at /docs/openapi.json (api/src/api/openapi).
# Leave unset in production: the spec lists every route. The committed copy is docs/openapi.json.
OPENAPI_ENABLED=false
# Add a variable here, and to api/src/config/env.ts's ENV_SCHEMA, in the same change that first
# reads it. main.ts/worker.ts validate them at boot and refuse to start on a bad or missing value
# (DATABASE_URL is required; the worker also needs its issuer signer below).
# No signer keys or ProgramAdminCap values belong in source control.

# Sui chain adapter (worker-only; see api/src/infra/clients/sui). No object ids are configured
# here: the package id is committed as TESTNET_OCTAP_PACKAGE_CONFIG in
# ts-sdks/packages/chain/src/constants.ts (selected by SUI_NETWORK), and each organization's
# program/policy/IssuerCap/shard ids live in its `programs` row (scripts/provision-program.mjs).
SUI_NETWORK=testnet
# Worker signers live in AWS KMS (docs/kms-signer.md): set the key ids below and let the AWS SDK's
# default credential chain find credentials — the `octap-testnet-signer` profile in ~/.aws, holding
# the access key the signer manager hands out, never access keys pasted here. A key ARN carries its
# region; an alias needs AWS_REGION. The testnet values:
#   AWS_REGION=ap-southeast-2
#   AWS_PROFILE=octap-testnet-signer
#   SUI_ISSUER_KMS_KEY_ID=alias/octap-testnet-issuer
#   SUI_PROGRAM_ADMIN_KMS_KEY_ID=alias/octap-testnet-program-admin
# Issuer key (receives every program's IssuerCap; contracts/sui/DEPLOYMENTS.md). IssuerCap only —
# never the AdminCap key. Key id, key ARN, alias/<name>, or alias ARN.
SUI_ISSUER_KMS_KEY_ID=
# Local-only fallback when SUI_ISSUER_KMS_KEY_ID is unset: a bech32 "suiprivkey1..." ed25519
# secret. Refused on SUI_NETWORK=mainnet. Never commit a real value.
SUI_ISSUER_PRIVATE_KEY=
# Outcome-unknown chain submits (api/src/domain/credits/chain-outcome.reconciler.ts): how often the
# worker looks, how old an unresolved command must be first, and how many per pass. Defaults shown.
# CHAIN_OUTCOME_RECONCILE_INTERVAL_MS=60000
# CHAIN_OUTCOME_RECONCILE_AFTER_MS=300000
# CHAIN_OUTCOME_RECONCILE_BATCH_SIZE=20
# Earn/reversal chain submits (api/src/domain/credits/chain-submit.worker.ts). Defaults shown.
# CHAIN_SUBMIT_POLL_INTERVAL_MS=3000
# CHAIN_SUBMIT_BATCH_SIZE=5
# CHAIN_SUBMIT_STALE_PROCESSING_MS=300000
# Webhook delivery worker (api/src/domain/webhooks). Defaults shown.
# WEBHOOK_DELIVERY_POLL_INTERVAL_MS=3000
# WEBHOOK_DELIVERY_BATCH_SIZE=10
# Trimming organization_events after 30 days (api/src/domain/events/event-retention.worker.ts). Default shown.
# EVENT_RETENTION_SWEEP_INTERVAL_MS=3600000
# Trimming api_request_logs after 30 days (api/src/domain/developer/request-log-retention.worker.ts). Default shown.
# REQUEST_LOG_RETENTION_SWEEP_INTERVAL_MS=3600000
# Marking vouchers EXPIRED and sending voucher.expired / voucher.member_expired
# (api/src/domain/rewards/voucher-expiry.worker.ts). Default shown.
# VOUCHER_EXPIRY_SWEEP_INTERVAL_MS=60000
# Console event stream (api/src/domain/events): how often the HTTP process scans for new events, and
# how often an open stream sends a heartbeat and checks the caller's access again. Defaults shown.
# CONSOLE_EVENTS_POLL_INTERVAL_MS=1000
# CONSOLE_EVENTS_HEARTBEAT_MS=20000
# Checkpoint indexer (api/src/domain/indexer). Defaults shown.
# INDEXER_POLL_INTERVAL_MS=5000
# INDEXER_PAGE_SIZE=50
# INDEXER_MAX_PAGES_PER_POLL=20

# Enoki (zkLogin + sponsored transactions; api/src/infra/clients/enoki). This is an app API key,
# not a signer key, so — unlike the issuer signer — it's fine in the HTTP process. Create an
# app at portal.enoki.mystenlabs.com for SUI_NETWORK and paste its API key here.
ENOKI_API_KEY=

# Program admin signer (worker-only; api/src/infra/clients/sui/program-admin.client.ts). Used
# by the enabled provisioning worker and scripts/provision-program.mjs (domain/programs) — never by
# request-handling code. Holds an AdminCap: a much larger blast radius than the issuer, so it is a
# different KMS key, which an ordinary issuer-only worker's role cannot sign with — never the issuer key above.
SUI_PROGRAM_ADMIN_KMS_KEY_ID=
# Local-only raw-key fallback, same rules as SUI_ISSUER_PRIVATE_KEY. Never commit a real value.
SUI_PROGRAM_ADMIN_PRIVATE_KEY=
# Google Identity Services web client ID (public identifier, shared with portal builds).
CONSOLE_GOOGLE_CLIENT_ID=
# Stable 32-byte base64 key for encrypted, unverified CCCD storage. Keep it server-side.
ORGANIZATION_IDENTITY_ENCRYPTION_KEY=
# MCP sign-in (OCT-293): the public origin MCP hosts reach this API at (the OAuth issuer, no path),
# e.g. https://api.octap.example or http://localhost:3000. Add it to the Google client's authorized
# JavaScript origins, since the sign-in page runs Google Identity Services there.
MCP_OAUTH_ISSUER_URL=
# Stable 32-byte base64 key that signs MCP client registrations. Rotating it invalidates registered clients.
MCP_OAUTH_SIGNING_KEY=
# Dashboard assistant (OCT-308), answered by OpenAI. Until OPENAI_API_KEY, OPENAI_MODEL, the MCP URL
# and MCP sign-in (MCP_OAUTH_ISSUER_URL and MCP_OAUTH_SIGNING_KEY above) are set, the assistant route
# answers 503. Member data the assistant reads is sent to OpenAI as model input.
# Public origin of the OctaP MCP server (`octap-mcp serve-http`), without /mcp. OpenAI's servers
# call it, so it must be reachable from the internet (a tunnel in local development).
OCTAP_MCP_PUBLIC_URL=
# Assistant messages per console user per minute. Default 10.
ASSISTANT_RATE_LIMIT_PER_MINUTE=10
OPENAI_API_KEY=
# An OpenAI model id that supports the Responses API's MCP tool, e.g. from platform.openai.com/docs/models.
OPENAI_MODEL=

# Enable only on a worker configured for program-admin signing (never the HTTP process).
ORG_PROVISION_WORKER_ENABLED=false
ORG_PROVISION_POLL_INTERVAL_MS=3000
# How often the worker checks issuance budgets for the budget.low webhook. Default 5 minutes.
BUDGET_WARNING_POLL_INTERVAL_MS=300000
# How often the worker sends license.expiry_notice (30/7/1 days left, grace, expired). Default 15 minutes.
LICENSE_EXPIRY_POLL_INTERVAL_MS=900000

# Audit evidence (OCT-77, api/src/domain/audit/README.md). Off by default. On, the worker seals each
# organization's finished periods on Sui with the issuer key, which must hold the octap_audit SealerCap
# (contracts/audit/DEPLOYMENTS.md). A period lasts EVIDENCE_PERIOD_MS (a UTC day; 300000 for a demo) and is
# sealed EVIDENCE_SEAL_DELAY_MS after it ends. Defaults shown.
# EVIDENCE_SEAL_ENABLED=false
# EVIDENCE_PERIOD_MS=86400000
# EVIDENCE_SEAL_DELAY_MS=600000
# EVIDENCE_SEAL_INTERVAL_MS=60000
# The encrypted copy of each sealed bundle, in a Walrus Console private folder. Off unless both the API key
# (read_write) and the folder are set. Create the folder in Console first, then mint the key and sign its
# access grant: a key is granted the private folders that exist when it is minted.
# WALRUS_CONSOLE_NETWORK=mainnet
# WALRUS_CONSOLE_API_KEY=
# WALRUS_CONSOLE_BUCKET_ID=

# Organization slug entry is implemented but not operational by default.
ORG_SLUG_ENTRY_ENABLED=false
