API_HOST=127.0.0.1
API_PORT=3000
# Supabase PostgreSQL Connection String
# Pooler (Supavisor / port 6543, recommended for multi-worker scaling):
# DATABASE_URL=postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# Direct connection (port 5432):
# DATABASE_URL=postgresql://postgres:[db-password]@db.[project-ref].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=
DB_MAX_CONNECTIONS=10
# `docker-compose up -d` (see docker-compose.yml) gives you a local Postgres on 5433
# (not 5432, to avoid clashing with one already running on the host) and Redis on 6379:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/octap_dev
REDIS_URL=redis://127.0.0.1:6379
# Requests allowed per API credential per 60s window (api/src/infra/auth/rate-limit.util.ts).
RATE_LIMIT_MAX_REQUESTS=120
# Add a variable here in the same change that first reads it.
# No signer keys or ProgramAdminCap values belong in source control.

# Sui chain adapter (worker-only; see api/src/infra/clients/sui). No object ids are configured
# here: the package id is committed as TESTNET_OCTAP_PACKAGE_CONFIG in
# ts-sdks/packages/chain/src/constants.ts (selected by SUI_NETWORK), and each organization's
# program/policy/IssuerCap/shard ids live in its `programs` row (scripts/provision-program.mjs).
SUI_NETWORK=testnet
# Worker signers live in AWS KMS (docs/kms-signer.md): set the key ids below and let the AWS SDK's
# default credential chain find credentials — the `octap-testnet-signer` profile in ~/.aws, holding
# the access key the signer manager hands out, never access keys pasted here. A key ARN carries its
# region; an alias needs AWS_REGION. The testnet values:
#   AWS_REGION=ap-southeast-2
#   AWS_PROFILE=octap-testnet-signer
#   SUI_ISSUER_KMS_KEY_ID=alias/octap-testnet-issuer
#   SUI_PROGRAM_ADMIN_KMS_KEY_ID=alias/octap-testnet-program-admin
# Issuer key (receives every program's IssuerCap; contracts/sui/DEPLOYMENTS.md). IssuerCap only —
# never the AdminCap key. Key id, key ARN, alias/<name>, or alias ARN.
SUI_ISSUER_KMS_KEY_ID=
# Local-only fallback when SUI_ISSUER_KMS_KEY_ID is unset: a bech32 "suiprivkey1..." ed25519
# secret. Refused on SUI_NETWORK=mainnet. Never commit a real value.
SUI_ISSUER_PRIVATE_KEY=
# Outcome-unknown chain submits (api/src/domain/credits/chain-outcome.reconciler.ts): how often the
# worker looks, how old an unresolved command must be first, and how many per pass. Defaults shown.
# CHAIN_OUTCOME_RECONCILE_INTERVAL_MS=60000
# CHAIN_OUTCOME_RECONCILE_AFTER_MS=300000
# CHAIN_OUTCOME_RECONCILE_BATCH_SIZE=20

# Enoki (zkLogin + sponsored transactions; api/src/infra/clients/enoki). This is an app API key,
# not a signer key, so — unlike the issuer signer — it's fine in the HTTP process. Create an
# app at portal.enoki.mystenlabs.com for SUI_NETWORK and paste its API key here.
ENOKI_API_KEY=

# Program admin signer (worker-only; api/src/infra/clients/sui/program-admin.client.ts). Used
# only by scripts/provision-program.mjs / top-up-budget.mjs (domain/programs) — never by
# request-handling code. Holds an AdminCap: a much larger blast radius than the issuer, so it is a
# different KMS key, which a hosted worker's role can't sign with — never the issuer key above.
SUI_PROGRAM_ADMIN_KMS_KEY_ID=
# Local-only raw-key fallback, same rules as SUI_ISSUER_PRIVATE_KEY. Never commit a real value.
SUI_PROGRAM_ADMIN_PRIVATE_KEY=
# Google Identity Services web client ID (public identifier, shared with portal builds).
CONSOLE_GOOGLE_CLIENT_ID=
# Stable 32-byte base64 key for encrypted, unverified CCCD storage. Keep it server-side.
ORGANIZATION_IDENTITY_ENCRYPTION_KEY=
