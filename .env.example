API_HOST=127.0.0.1
API_PORT=3000
# Supabase PostgreSQL Connection String
# Pooler (Supavisor / port 6543, recommended for multi-worker scaling):
# DATABASE_URL=postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# Direct connection (port 5432):
# DATABASE_URL=postgresql://postgres:[db-password]@db.[project-ref].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=
DB_MAX_CONNECTIONS=10
# Add a variable here in the same change that first reads it.
# No signer keys or ProgramAdminCap values belong in source control.

# Sui chain adapter (worker-only; see api/src/infra/clients/sui). Demo-scoped to a single
# program/policy per contracts/sui/DEPLOYMENTS.md until domain/programs exists (docs/roadmap.md).
SUI_NETWORK=testnet
SUI_PACKAGE_ID=
SUI_PROGRAM_CONTROL_ID=
SUI_POLICY_VERSION_ID=
SUI_ISSUER_CAP_ID=
# bech32 "suiprivkey1..." ed25519 secret for the address holding SUI_ISSUER_CAP_ID.
# IssuerCap only — never an AdminCap key. Never commit a real value.
SUI_ISSUER_PRIVATE_KEY=
