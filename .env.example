API_HOST=127.0.0.1
API_PORT=3000
# Supabase PostgreSQL Connection String
# Pooler (Supavisor / port 6543, recommended for multi-worker scaling):
# DATABASE_URL=postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# Direct connection (port 5432):
# DATABASE_URL=postgresql://postgres:[db-password]@db.[project-ref].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=
DB_MAX_CONNECTIONS=10
# `docker-compose up -d` (see docker-compose.yml) gives you a local Postgres on 5433
# (not 5432, to avoid clashing with one already running on the host) and Redis on 6379:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/octap_dev
REDIS_URL=redis://127.0.0.1:6379
# Add a variable here in the same change that first reads it.
# No signer keys or ProgramAdminCap values belong in source control.

# Sui chain adapter (worker-only; see api/src/infra/clients/sui). Package/program/policy/
# IssuerCap object ids are NOT configured here — they're public on-chain ids, committed as
# TESTNET_OCTAP_DEMO_PROGRAM_CONFIG in ts-sdks/packages/chain/src/constants.ts (same pattern as
# @walrus-console/bucket-groups' TESTNET_BUCKET_GROUP_PACKAGE_CONFIG), selected by SUI_NETWORK.
SUI_NETWORK=testnet
# bech32 "suiprivkey1..." ed25519 secret for the address holding that config's issuerCapId.
# IssuerCap only — never an AdminCap key. Never commit a real value.
SUI_ISSUER_PRIVATE_KEY=
