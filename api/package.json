{
  "name": "@octap/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#api/*": "./dist/api/*",
    "#domain/*": "./dist/domain/*",
    "#infra/*": "./dist/infra/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file=../.env dist/main.js",
    "start:worker": "node --env-file=../.env dist/worker.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/credential-provider-node": "^3.972.90",
    "@mysten/aws-kms-signer": "^0.3.33",
    "@mysten/enoki": "^1.3.1",
    "@mysten/sui": "^2.38.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "11.4.7",
    "@octap/chain": "0.0.0",
    "@octap/contracts": "0.0.0",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "google-auth-library": "^11.3.2",
    "ioredis": "^6.0.0",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11"
  }
}
