{
  "name": "octap-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15 <25"
  },
  "workspaces": [
    "ts-sdks/packages/contracts",
    "ts-sdks/packages/chain",
    "ts-sdks/packages/node",
    "ts-sdks/packages/browser",
    "api"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.test.json",
    "lint": "eslint api/src api/tests ts-sdks/packages scripts vitest.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start:api": "npm run start --workspace @octap/api",
    "start:worker": "npm run start:worker --workspace @octap/api",
    "check:bootstrap": "node scripts/check-bootstrap.mjs",
    "seed:dev-credential": "node scripts/seed-dev-credential.mjs",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --project unit",
    "db:generate": "npm run db:generate --workspace @octap/api",
    "db:migrate": "npm run db:migrate --workspace @octap/api",
    "db:push": "npm run db:push --workspace @octap/api",
    "db:studio": "npm run db:studio --workspace @octap/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nestjs/testing": "^11.2.7",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.0.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
