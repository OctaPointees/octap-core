{
  "name": "octap-source",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15 <25"
  },
  "workspaces": [
    "ts-sdks/packages/contracts",
    "ts-sdks/packages/node",
    "ts-sdks/packages/browser",
    "api",
    "frontend"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint api/src ts-sdks/packages frontend scripts",
    "start:api": "npm run start --workspace @octap/api",
    "start:worker": "npm run start:worker --workspace @octap/api",
    "check:bootstrap": "node scripts/check-bootstrap.mjs",
    "dev:frontend": "npm run dev --workspace @octap/frontend",
    "start:frontend": "npm run start --workspace @octap/frontend"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
