{
  "name": "octap-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15 <25"
  },
  "workspaces": [
    "ts-sdks/packages/contracts",
    "ts-sdks/packages/node",
    "ts-sdks/packages/browser",
    "api"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint api/src ts-sdks/packages scripts",
    "start:api": "npm run start --workspace @octap/api",
    "start:worker": "npm run start:worker --workspace @octap/api",
    "check:bootstrap": "node scripts/check-bootstrap.mjs",
    "seed:dev-credential": "node scripts/seed-dev-credential.mjs",
    "test": "node --test scripts/test-unit.mjs",
    "db:generate": "npm run db:generate --workspace @octap/api",
    "db:migrate": "npm run db:migrate --workspace @octap/api",
    "db:push": "npm run db:push --workspace @octap/api",
    "db:studio": "npm run db:studio --workspace @octap/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
